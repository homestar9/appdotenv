# Comment line
   # Indented comment

PLAIN=plain value
export EXPORTED=yes
SPACED =  padded
EMPTY=
DOUBLE="double quoted # not a comment"
ESCAPED="line1\nline2\t\"quoted\" back\\slash"
SINGLE='single $literal \n kept'
TRAILING=value # trailing comment
HASH_INSIDE=abc#def
URL=https://example.com/path?a=1&b=2
EQUALS=a=b=c
lowercase=lower
NOT A VALID LINE
=novalue
